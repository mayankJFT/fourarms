# ──────────────────────────────────────────────
# QCI AI Knowledge Hub — Environment Config
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# LLM (Groq) — https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Vector Store (Pinecone) — https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=qci-knowledge-hub
PINECONE_ENV=us-east-1

# Speech-to-Text (Deepgram) — https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/?appName=Cluster0
MONGODB_DB=qci_knowledge_hub

# Auth (JWT)
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Storage
UPLOAD_DIR=./uploads

# First-run Admin Seed
SEED_ADMIN_EMAIL=admin@qci.gov.in
SEED_ADMIN_PASSWORD=Admin@QCI2026

# RAG Tuning
RELEVANCE_THRESHOLD=0.10
RAG_TOP_K=8
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
